{
    "name": "turismove-backend",
    "version": "1.0.0",
    "description": "Backend API REST para el proyecto integrador TurismoVE.",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon src/server.js",
        "start": "node src/server.js",
        "db:check": "node src/database/check.js",
        "db:migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:seed": "sequelize-cli db:seed:all",
        "db:seed:undo": "sequelize-cli db:seed:undo:all"
    },
    "keywords": [
        "turismo",
        "venezuela",
        "express",
        "api-rest",
        "jwt",
        "sequelize",
        "mysql",
        "proyecto-integrador"
    ],
    "author": "Equipo TurismoVE",
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.22.3",
        "node-cache": "^5.1.2",
        "sequelize": "^6.37.5",
        "swagger-ui-express": "^5.0.1",
        "yamljs": "^0.3.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.9",
        "sequelize-cli": "^6.6.2"
    }
}
